{
  "experiment_name": "debug_run",
  "seed": 42,
  "debug": true,
  "data": {
    "data_dir": "data/processed",
    "image_size": [
      320,
      240
    ],
    "batch_size": 16,
    "num_workers": 4,
    "train_split": "train",
    "val_split": "val",
    "test_split": "test",
    "max_train_samples": 1000,
    "max_val_samples": 200
  },
  "visual": {
    "backbone": "resnet101",
    "pretrained": true,
    "detector_type": "faster_rcnn",
    "num_object_features": 2048,
    "max_objects_per_image": 10,
    "spatial_feat_dim": 128,
    "semantic_feat_dim": 512,
    "freeze_backbone": false,
    "learning_rate": 0.0001
  },
  "question": {
    "vocab_size": 1000,
    "max_question_length": 46,
    "encoder_type": "lstm",
    "embedding_dim": 256,
    "hidden_dim": 512,
    "num_layers": 2,
    "dropout": 0.3,
    "max_program_length": 27,
    "program_vocab_size": 100,
    "learning_rate": 0.001
  },
  "reasoning": {
    "module_dim": 512,
    "max_execution_steps": 50,
    "modules": [
      "filter_color",
      "filter_shape",
      "filter_material",
      "filter_size",
      "query_color",
      "query_shape",
      "query_material",
      "query_size",
      "same_color",
      "same_shape",
      "same_material",
      "same_size",
      "equal_integer",
      "less_than",
      "greater_than",
      "count",
      "exist",
      "unique",
      "relate",
      "intersect",
      "union"
    ],
    "colors": [
      "gray",
      "red",
      "blue",
      "green",
      "brown",
      "purple",
      "cyan",
      "yellow"
    ],
    "shapes": [
      "cube",
      "sphere",
      "cylinder"
    ],
    "materials": [
      "rubber",
      "metal"
    ],
    "sizes": [
      "small",
      "large"
    ],
    "relations": [
      "left",
      "right",
      "behind",
      "front"
    ]
  },
  "training": {
    "num_epochs": 5,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "optimizer": "adam",
    "scheduler": "reduce_on_plateau",
    "patience": 5,
    "factor": 0.5,
    "min_lr": 1e-06,
    "grad_clip": 5.0,
    "pretrain_visual_epochs": 1,
    "pretrain_question_epochs": 2,
    "joint_training_epochs": 2,
    "visual_loss_weight": 1.0,
    "program_loss_weight": 1.0,
    "answer_loss_weight": 1.0,
    "save_every": 5,
    "keep_best": 3,
    "log_every": 100,
    "validate_every": 1,
    "device": "cuda",
    "mixed_precision": true
  },
  "paths": {
    "root_dir": ".",
    "data_dir": "data/processed",
    "checkpoint_dir": "checkpoints",
    "log_dir": "logs",
    "output_dir": "outputs",
    "best_model_path": "checkpoints/best_model.pt",
    "vocab_path": "data/vocab.json"
  }
}